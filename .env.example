# Copy this file to .env and fill in your key:
#   cp .env.example .env
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — if set, POST /run requires this exact value in an X-API-Key
# header. Strongly recommended before exposing the dashboard via ngrok or
# any other public URL, otherwise anyone with the link can make this server
# launch a browser against arbitrary sites.
DASHBOARD_API_KEY=

# Optional — when true, /run refuses any target (or login_url) that resolves
# to a private/internal/loopback address (SSRF protection). Keep this FALSE
# for normal use, since testing your own local dev app (http://localhost:...)
# is the main use case. Flip to true only if you're exposing this publicly
# and want defense-in-depth beyond DASHBOARD_API_KEY.
BLOCK_PRIVATE_TARGETS=false

# Optional — a Slack "Incoming Webhook" URL (or any endpoint that accepts a
# plain JSON POST). When set, a message is sent every time a run finishes
# or errors, summarizing the bug counts. Leave blank to disable.
NOTIFY_WEBHOOK_URL=

# Optional — included as a clickable link in notifications, e.g. your
# ngrok URL. Purely cosmetic; leave blank if you don't want the link.
PUBLIC_DASHBOARD_URL=